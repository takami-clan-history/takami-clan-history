      <td nowrap height="14" width="0"></td>
      <td align="center" bgcolor="#f8f8f8" nowrap height="14" width="276"><a href="1dai.htm"><font color="#0054B8" size="2">本国及び初代和田勝五郎重治（後高見権右衛門重治）</font></a></td>
      <td align="right" nowrap height="14" width="14"><font color="#ff0000">4</font></td>
      <td nowrap height="14" width="0"></td>
      <td align="center" bgcolor="#f8f8f8" nowrap height="14" width="285"><font color="#0054B8" size="2">　　　　　　　<a href="2dai.htm">二代高見権右衛門重政</a>　　　　　　　　</font></td>
    </tr>
    <tr> 
      <td nowrap width="12"></td>
      <td nowrap width="0"></td>
      <td nowrap width="276"></td>
      <td nowrap width="14"></td>
      <td nowrap width="0"></td>
      <td nowrap width="285"></td>
    </tr>
    <tr> 
      <td align="right" nowrap width="12"><font color="#ff0000">5</font></td>
      <td nowrap width="0"></td>
      <td align="center" bgcolor="#f8f8f8" nowrap width="276"><font color="#0054B8" size="2"><a href="3dai.htm">三代高見権之助</a></font></td>
